NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://vestry_app:REPLACE_APP_PASSWORD@localhost:55432/vestry
MIGRATION_DATABASE_URL=postgres://vestry_owner:REPLACE_OWNER_PASSWORD@localhost:55432/vestry
DB_OWNER_PASSWORD=REPLACE_OWNER_PASSWORD
DB_APP_PASSWORD=REPLACE_APP_PASSWORD
REDIS_URL=redis://localhost:56379
STORAGE_DRIVER=local
STORAGE_PATH=./data/originals
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=vestry-originals
S3_ACCESS_KEY=REPLACE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_SECRET_KEY
COOKIE_SECURE=false
MFA_ENCRYPTION_KEY=REPLACE_64_HEX_CHARACTERS
OCR_PROVIDER=manual
CLAMAV_HOST=
CLAMAV_PORT=3310
REQUIRE_MALWARE_SCAN=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
SEED_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Vercel only: independent random secret, at least 32 characters.
CRON_SECRET=
# Direct empty target URL; local migration tool only, never Vercel.
RESTORE_DATABASE_URL=
